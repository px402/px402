# PX-402 configuration. Every flag defaults to the safest value; the server
# boots with no env at all as a fully dry-run facilitator.

# ---- public status server (health, privacy transparency, stealth inbox) ----
PX402_HOST=127.0.0.1
PX402_PORT=8787
# Bound into browser-scoped stealth intent signatures (staging vs production
# replay separation). Required when the browser stealth inbox is enabled.
#PX402_DEPLOYMENT_ID=px402-prod-1

# ---- storage ----
# 64-char hex. Encrypts every durable book at rest. Required in production.
#PX402_DATA_ENCRYPTION_KEY=

# Admin bearer token: settlement admin endpoints + stealth inbox pairing tickets.
#PX402_ADMIN_TOKEN=

# ---- private agent RPC (the facilitator surface) ----
PX402_AGENT_RPC_ENABLED=true
PX402_AGENT_RPC_HOST=127.0.0.1
PX402_AGENT_RPC_PORT=3099
# JSON array of agent endpoints: [{"agentId":"agent-a","walletAddress":"0x…",
#   "vpnAddress":"10.8.0.2","x402BalanceAtomic":"0"}, …]
#PX402_AGENT_ENDPOINTS=

# ---- private payment ledger (deposit → private balance → batched exit) ----
PX402_PRIVATE_LEDGER_ENABLED=false
#PX402_PRIVATE_LEDGER_RETENTION_MS=900000
#PX402_PRIVATE_LEDGER_SWEEP_MS=30000
#PX402_PRIVATE_LEDGER_EPHEMERAL_DIR=
# Defaults to true in production: the ephemeral epoch journal must live on tmpfs.
#PX402_PRIVATE_LEDGER_REQUIRE_TMPFS=true

# ---- blind vouchers (Chaumian ecash over ledger balances) ----
PX402_BLIND_VOUCHERS_ENABLED=false
#PX402_BLIND_VOUCHER_MINT_IDENTITY_KEY=
#PX402_BLIND_VOUCHER_DENOMINATIONS=["100000","1000000","10000000","100000000"]
#PX402_BLIND_VOUCHER_KEYSET_GRACE_MS=604800000
#PX402_BLIND_VOUCHER_MAX_OUTPUTS=64
#PX402_BLIND_VOUCHER_MAX_PROOFS=64

# ---- pool payouts (batched, jittered, concentration-gated exits) ----
PX402_POOL_PAYOUT_ENABLED=false
PX402_POOL_PAYOUT_BATCHING_ENABLED=false
#PX402_POOL_PAYOUT_DENOMINATIONS_ENABLED=false
#PX402_PAYOUT_QUANTIZE=off
#PX402_POOL_PAYOUT_COHORTS_ENABLED=false
#PX402_PAYOUT_DENOMINATIONS=
#PX402_POOL_PAYOUT_FLUSH_MS=60000
#PX402_POOL_PAYOUT_MAX_JITTER_MS=30000
#PX402_POOL_PAYOUT_CONCENTRATION_ENABLED=false
# Static K must stay 1 in production; use the adaptive target instead.
#PX402_POOL_PAYOUT_KEFF_TARGET=1
#PX402_POOL_PAYOUT_KEFF_ADAPTIVE=false
#PX402_POOL_PAYOUT_KEFF_CEILING=8
#PX402_POOL_PAYOUT_KEFF_PUBLISH_ENABLED=false
#PX402_POOL_PAYOUT_MAX_HOLD_MS=900000
#PX402_POOL_PAYOUT_FINALITY=finalized
#PX402_POOL_PAYOUT_KEFF_ADAPTIVE_WINDOW_MS=21600000
#PX402_POOL_PAYOUT_KEFF_ADAPTIVE_MIN_SAMPLES=20
#PX402_POOL_PAYOUT_KEFF_ADAPTIVE_QUANTILE=0.5
#PX402_POOL_PAYOUT_SCHEDULE_EPOCH_MS=3600000
#PX402_POOL_PAYOUT_MAX_ATTEMPTS=3
#PX402_POOL_PAYOUT_CONFIRMATION_FLOOR=6
#PX402_POOL_PAYOUT_TIMEOUT_MS=120000
#PX402_POOL_PAYOUT_RECONCILE_MS=30000
#PX402_POOL_PAYOUT_RECOVERY_BUDGET_MS=15000
#PX402_POOL_PAYOUT_FEE_BUMP_AFTER_MS=45000
# Must not exceed PX402_POOL_PAYOUT_TIMEOUT_MS (enforced at boot).
#PX402_POOL_PAYOUT_DISPATCH_GRACE_MS=90000
#PX402_POOL_PAYOUT_CLAIM_TTL_MS=900000
#PX402_PAYOUT_POLICY_VERSION=

# ---- stealth deposits / stealth inbox ----
PX402_STEALTH_DEPOSITS_ENABLED=false
#PX402_DEPOSIT_SWEEP_MS=60000
#PX402_DEPOSIT_SWEEP_MIN_AGE_MS=300000
#PX402_DEPOSIT_SWEEP_MAX_PER_RUN=8
#PX402_DEPOSIT_SWEEP_CONFIRMATIONS=2
#PX402_DEPOSIT_SWEEP_BACKOFF_MS=30000
#PX402_DEPOSIT_SWEEP_MAX_ATTEMPTS=10
#PX402_DEPOSIT_RETENTION_MS=900000
# Must be >= the 900s deposit intent lifetime (enforced at boot).
#PX402_DEPOSIT_UNPAID_GRACE_MS=86400000
# Defaults ON (fund-loss protection, not a new surface). Opt out with "false".
#PX402_STEALTH_INBOX_ENABLED=true
#PX402_STEALTH_INBOX_RETENTION_MS=900000
#PX402_STEALTH_INBOX_DORMANT_MS=86400000
#PX402_STEALTH_INBOX_REAP_MS=300000
#PX402_STEALTH_SWEEP_RELAY_ENABLED=false
#PX402_STEALTH_INBOX_BROWSER_ENABLED=false
#PX402_STEALTH_INBOX_BROWSER_CLAIM=agent
#PX402_STEALTH_INBOX_RATE_PER_MIN=30
#PX402_STEALTH_INBOX_PAGE_SIZE=8
#PX402_STEALTH_INBOX_SUBSCRIPTION_TTL_MS=600000
#PX402_STEALTH_INBOX_PAIR_TICKET_TTL_MS=300000
#PX402_STEALTH_INBOX_SIMULATION=false

# ---- Base rail (USDC, EIP-3009) ----
#PX402_BASE_RPC_URL=https://mainnet.base.org
#PX402_BASE_TREASURY=
# Funded relayer that broadcasts transfers. Absent => dry-run (verify only).
#PX402_BASE_X402_SETTLER_KEY=
#PX402_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#PX402_BASE_USDC_DOMAIN_NAME=USD Coin
#PX402_BASE_USDC_DOMAIN_VERSION=2
# Deployed PX402BatchCommitment contract for public settlement commitments.
#PX402_PRIVATE_BATCH_CONTRACT=

# ---- Robinhood Chain rail (USDG, EIP-3009, eip155:4663) ----
#PX402_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
#PX402_RH_TREASURY=
#PX402_RH_X402_SETTLER_KEY=
#PX402_RH_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
#PX402_RH_USDG_DOMAIN_NAME=Global Dollar
#PX402_RH_USDG_DOMAIN_VERSION=1
#PX402_RH_PRIVATE_BATCH_CONTRACT=

# ---- Solana rail (USDC) ----
#PX402_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
#PX402_SOLANA_HISTORY_RPC_URL=
#PX402_SOLANA_TREASURY=
# base58 fee-payer keypair. Absent => verify-and-simulate dry-run.
#PX402_SOLANA_X402_SETTLER_KEY=
#PX402_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ---- confidential x402 (Token-2022 confidential transfer / EVM contract) ----
PX402_CONFIDENTIAL_X402_ENABLED=false
#PX402_CONFIDENTIAL_NETWORKS=[]
#PX402_SOLANA_CONFIDENTIAL_MINT=
#PX402_BASE_CONFIDENTIAL_CONTRACT=
#PX402_RH_CONFIDENTIAL_CONTRACT=
#PX402_CONFIDENTIAL_VERIFYING_KEY_HASH=
#PX402_CONFIDENTIAL_PROOF_TIMEOUT_MS=30000
